# Copia este archivo a sdkconfig.credentials (gitignored) y editá los valores.
# Es el archivo donde van los secretos. Se lee desde sdkconfig.defaults si existe.

# === WiFi ===
CONFIG_WIFI_SSID="YOUR_WIFI_SSID"
CONFIG_WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# === Tailscale ===
# Generar reusable key en https://login.tailscale.com/admin/settings/keys
CONFIG_TAILSCALE_AUTH_KEY="tskey-auth-XXXXXXXXXXXXX"
CONFIG_TAILSCALE_DEVICE_NAME="esp32-server-ctrl"

# === Telegram ===
CONFIG_TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN"
CONFIG_TELEGRAM_AUTHORIZED_IDS="111111111,222222222"

# === server ===
CONFIG_SERVER_IP="192.168.1.100"
CONFIG_SERVER_HTTP_PORT=9999
CONFIG_SERVER_SHUTDOWN_SECRET="YOUR_SECRET"
CONFIG_SERVER_MAC_HEX="00:11:22:33:44:55"

# === Readiness push (server -> ESP32) ===
# La MISMA cadena va en /etc/app-ready-notify.env en server. Sirve para que el
# propio servidor avise "ya estoy listo" con GET /notify/ready y el portal redirija
# en el acto, sin esperar al sondeo de 1 s. Vacio = endpoint deshabilitado, el
# ESP32 sigue detectingo readiness solo con sus propias sondas.
CONFIG_ESP32_READY_NOTIFY_SECRET="YOUR_SECRET"
